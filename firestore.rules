rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tvoja lista — samo ti, i to tek kad si prijavljen.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Profil koji ekipa vidi: ime, slika, dokle si stigao.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Ocene: svi prijavljeni čitaju, svako piše samo svoje.
    match /reviews/{rid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && rid == request.resource.data.itemId + '__' + request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text.size() <= 500;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Poruke ekipi: svi prijavljeni citaju, svako pise samo u svoje ime.
    match /notices/{nid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.text.size() <= 300;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Reakcije na ocene (🔥 😂 💀 👎): svako jednu po oceni, samo u svoje ime.
    match /reactions/{xid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && xid == request.resource.data.rid + '__' + request.auth.uid
        && request.resource.data.e in ['🔥', '😂', '💀', '👎'];
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Kodovi za nagrade: pravi ih samo Kosta, svi prijavljeni ih koriste
    match /codes/{code} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null
        && request.auth.token.email == 'kostabogdanic@gmail.com';
      allow update: if request.auth != null && (
        request.auth.token.email == 'kostabogdanic@gmail.com' || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy'])
          && !(request.auth.uid in resource.data.usedBy)
          && request.auth.uid in request.resource.data.usedBy
          && request.resource.data.used == resource.data.used + 1
          && (resource.data.max == 0 || resource.data.used < resource.data.max)
        )
      );
    }

    match /{document=**} { allow read, write: if false; }
  }
}
